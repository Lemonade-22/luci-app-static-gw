# Normalise line endings so the Linux build and the on-device shell scripts
# never receive CRLF. GitHub Actions YAML and OpenWrt build files must be LF.
* text=auto eol=lf

*.sh   text eol=lf
*.cjs  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.po   text eol=lf
*.pot  text eol=lf
Makefile text eol=lf
