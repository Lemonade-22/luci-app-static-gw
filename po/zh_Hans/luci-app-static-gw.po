"Language: zh_Hans\n"

#: htdocs/luci-static/resources/view/network/static-gw.js:1
msgid "Static Address Binding"
msgstr "静态地址绑定"

#: htdocs/luci-static/resources/view/network/static-gw.js:2
msgid "Bind fixed IPv4 addresses to MAC and optionally override gateway (option 3) and DNS (option 6) for individual clients."
msgstr "将固定 IPv4 地址绑定到 MAC，并可为指定客户端下发自定义网关（DHCP option 3）和 DNS（option 6）。"

#: htdocs/luci-static/resources/view/network/static-gw.js:3
msgid "LAN: "
msgstr "LAN："

#: htdocs/luci-static/resources/view/network/static-gw.js:4
msgid "DHCP pool: "
msgstr "DHCP 地址池："

#: htdocs/luci-static/resources/view/network/static-gw.js:5
msgid "(from interface config)"
msgstr "（来自接口配置）"

#: htdocs/luci-static/resources/view/network/static-gw.js:6
msgid "Default gateway: "
msgstr "默认网关："

#: htdocs/luci-static/resources/view/network/static-gw.js:7
msgid "System default (undetermined)"
msgstr "系统默认（未确定）"

#: htdocs/luci-static/resources/view/network/static-gw.js:8
msgid "Editing disabled: "
msgstr "编辑已禁用："

#: htdocs/luci-static/resources/view/network/static-gw.js:9
msgid "LAN interface is not configured as static IPv4"
msgstr "LAN 接口未配置为静态 IPv4"

#: htdocs/luci-static/resources/view/network/static-gw.js:10
msgid "LAN has no IPv4 address configured"
msgstr "LAN 未配置 IPv4 地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:11
msgid "Cannot determine LAN subnet"
msgstr "无法确定 LAN 子网"

#: htdocs/luci-static/resources/view/network/static-gw.js:12
msgid "No active DHCPv4 configuration for LAN"
msgstr "LAN 没有活动的 DHCPv4 配置"

#: htdocs/luci-static/resources/view/network/static-gw.js:13
msgid "Multiple dnsmasq instances detected"
msgstr "检测到多个 dnsmasq 实例"

#: htdocs/luci-static/resources/view/network/static-gw.js:14
msgid "Static Bindings"
msgstr "静态绑定"

#: htdocs/luci-static/resources/view/network/static-gw.js:15
msgid "Edit static binding"
msgstr "编辑静态绑定"

#: htdocs/luci-static/resources/view/network/static-gw.js:16
msgid "Hostname"
msgstr "主机名"

#: htdocs/luci-static/resources/view/network/static-gw.js:17
msgid "Hostname or MAC address is required"
msgstr "必须填写主机名或 MAC 地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:18
msgid "MAC Address"
msgstr "MAC 地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:19
msgid "Expecting a valid MAC address"
msgstr "需要有效的 MAC 地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:20
msgid "MAC must be a valid unicast address"
msgstr "MAC 必须是有效的单播地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:21
msgid "MAC address already used by another binding"
msgstr "MAC 地址已被其他绑定使用"

#: htdocs/luci-static/resources/view/network/static-gw.js:22
msgid "Fixed IPv4"
msgstr "固定 IPv4"

#: htdocs/luci-static/resources/view/network/static-gw.js:23
msgid "Fixed IPv4 address is required"
msgstr "必须填写固定 IPv4 地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:24
msgid "Address is outside the LAN subnet"
msgstr "地址不在 LAN 子网内"

#: htdocs/luci-static/resources/view/network/static-gw.js:25
msgid "Cannot use network or broadcast address"
msgstr "不能使用网络地址或广播地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:26
msgid "Cannot bind the router address itself"
msgstr "不能绑定路由器自身地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:27
msgid "IPv4 already used by another binding"
msgstr "IPv4 已被其他绑定使用"

#: htdocs/luci-static/resources/view/network/static-gw.js:28
msgid "Address currently leased to another device"
msgstr "地址当前已被另一台设备租用"

#: htdocs/luci-static/resources/view/network/static-gw.js:29
msgid "Gateway"
msgstr "网关"

#: htdocs/luci-static/resources/view/network/static-gw.js:30
msgid "Inherit system"
msgstr "继承系统"

#: htdocs/luci-static/resources/view/network/static-gw.js:31
msgid "Decided by other rules"
msgstr "由其他规则决定"

#: htdocs/luci-static/resources/view/network/static-gw.js:32
msgid "Gateway must be inside the LAN subnet"
msgstr "网关必须在 LAN 子网内"

#: htdocs/luci-static/resources/view/network/static-gw.js:33
msgid "Gateway cannot be network or broadcast address"
msgstr "网关不能是网络地址或广播地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:34
msgid "Gateway cannot be the same as the fixed IP"
msgstr "网关不能与固定 IP 相同"

#: htdocs/luci-static/resources/view/network/static-gw.js:35
msgid "Custom DNS"
msgstr "自定义 DNS"

msgid "Send a DNS server (DHCP option 6) to this client only."
msgstr "仅为该客户端下发 DNS 服务器（DHCP option 6）。"

msgid "DNS server"
msgstr "DNS 服务器"

msgid "same as gateway"
msgstr "与网关相同"

msgid "IPv4 address of the DNS server for this client. Leave empty to use the gateway address above."
msgstr "该客户端使用的 DNS 服务器 IPv4 地址。留空则使用上方的网关地址。"

msgid "Invalid IPv4 address"
msgstr "无效的 IPv4 地址"

#: htdocs/luci-static/resources/view/network/static-gw.js:36
msgid "Lease time"
msgstr "租期"

#: htdocs/luci-static/resources/view/network/static-gw.js:37
msgid "Inherit from pool"
msgstr "继承地址池"

#: htdocs/luci-static/resources/view/network/static-gw.js:38
msgid "5 minutes"
msgstr "5 分钟"

#: htdocs/luci-static/resources/view/network/static-gw.js:39
msgid "30 minutes"
msgstr "30 分钟"

#: htdocs/luci-static/resources/view/network/static-gw.js:40
msgid "1 hour"
msgstr "1 小时"

#: htdocs/luci-static/resources/view/network/static-gw.js:41
msgid "12 hours"
msgstr "12 小时"

#: htdocs/luci-static/resources/view/network/static-gw.js:42
msgid "24 hours"
msgstr "24 小时"

#: htdocs/luci-static/resources/view/network/static-gw.js:43
msgid "7 days"
msgstr "7 天"

#: htdocs/luci-static/resources/view/network/static-gw.js:44
msgid "Infinite"
msgstr "永久"

#: htdocs/luci-static/resources/view/network/static-gw.js:45
msgid "Invalid lease time format (e.g. 12h, 7d)"
msgstr "租期格式无效（例如 12h、7d）"

#: htdocs/luci-static/resources/view/network/static-gw.js:46
msgid "Status"
msgstr "状态"

#: htdocs/luci-static/resources/view/network/static-gw.js:47
msgid "Read-only (manage in official DHCP page)"
msgstr "只读（请在官方 DHCP 页面管理）"

msgid "LAN interface not found in /etc/config/network"
msgstr "/etc/config/network 中未找到 LAN 接口"

msgid "not detected - inheriting interface configuration"
msgstr "未检测到，沿用接口配置"

msgid "Notice: "
msgstr "提示："

msgid "No DHCP pool section for LAN could be identified, so the pool range is unknown. Bindings can still be created and edited."
msgstr "未能识别 LAN 的 DHCP 地址池配置，因此地址池范围未知。仍可正常创建和编辑绑定。"

msgid "Inherit system (leave empty)"
msgstr "继承系统（留空）"

msgid "Optional. Overrides the IPv4 gateway (DHCP option 3) for this client. Leave empty to inherit the system gateway."
msgstr "可选。仅为该客户端覆盖 IPv4 网关（DHCP option 3）。留空则继承系统网关。"

msgid "Online devices"
msgstr "在线设备"

msgid "Devices that currently hold a DHCP lease. “Make static” stages a fixed binding for the leased address; commit it with “Save & Apply”."
msgstr "当前持有 DHCP 租约的设备。点击“设为静态”会暂存该地址的固定绑定，再点“保存并应用”生效。"

msgid "IPv4 address"
msgstr "IPv4 地址"

msgid "Lease expires"
msgstr "租约到期"

msgid "Action"
msgstr "操作"

msgid "Make static"
msgstr "设为静态"

msgid "Static"
msgstr "静态"

msgid "Staged"
msgstr "已暂存"

msgid "This lease has no usable MAC address."
msgstr "该租约没有可用的 MAC 地址。"

msgid "This device already has a static binding."
msgstr "该设备已有静态绑定。"

msgid "Staged a static binding for %s. Click “Save & Apply” to commit."
msgstr "已暂存 %s 的静态绑定。请点击“保存并应用”提交。"

msgid "No active DHCP leases."
msgstr "当前没有活动的 DHCP 租约。"

msgid "infinite"
msgstr "永久"

msgid "Invalid MAC address"
msgstr "无效的 MAC 地址"
